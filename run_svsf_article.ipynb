   "cell_type": "code",
   "source": [
    "# Create directories\n",
    "!mkdir -p templates reports\n",
    "\n",
    "# Upload index_v11.html and history_v11.html to Colab (left panel > upload),\n",
    "# then this cell moves them into templates/:\n",
    "import os, shutil\n",
    "for f in ['index_v11.html','history_v11.html']:\n",
    "    if os.path.exists(f):\n",
    "        shutil.move(f, f'templates/{f}'); print(f'{f} → templates/')\n",
    "    elif os.path.exists(f'templates/{f}'):\n",
    "        print(f'{f} is already in templates/')\n",
    "    else:\n",
    "        print(f'WARNING: {f} not found — upload via left panel and rerun this cell')\n"
   ],
   "metadata": {
